# Help Desk RAG 設定範例。helpdesk-api、ingestion-worker 與 alembic 共用同一份設定。
# 複製成 .env 後再填值；環境變數優先於 .env。

LOG_LEVEL=INFO
# production 時 helpdesk-api 不接受開發用身分 header；ACL 開啟又沒有正式登入時拒絕啟動。
APP_ENV=development

# 兩個開關的程式預設都是 true。本機測試時把 .env 裡這兩個設成 false。
# ACCESS_CONTROL_ENABLED=false：不比對 ACL，metadata 選填，所有文件都可以送到外部 LLM。
# SENSITIVE_DATA_SCAN_ENABLED=false：送往外部 LLM 前不做敏感資料掃描。
ACCESS_CONTROL_ENABLED=true
SENSITIVE_DATA_SCAN_ENABLED=true

# groq 是正式使用的 provider；fake 只給測試用，不需要 GROQ_API_KEY。
# LLM_PROVIDER=groq 時 helpdesk-api 必須有 GROQ_API_KEY，沒有就拒絕啟動；
# ingestion-worker 與 alembic 不呼叫 LLM，不需要這把金鑰。
LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# JSON 陣列；GROQ_BASE_URL 的主機必須在這份清單內，而且必須是 HTTPS。
GROQ_ALLOWED_HOSTS=["api.groq.com"]
GROQ_CONNECT_TIMEOUT_SECONDS=5
GROQ_READ_TIMEOUT_SECONDS=60
GROQ_TOTAL_TIMEOUT_SECONDS=75
GROQ_MAX_OUTPUT_TOKENS=3000
GROQ_TEMPERATURE=0.3
# gpt-oss 的推理強度（low、medium、high）。推理 token 算在輸出 token 裡，也吃每日額度。
ANSWER_REASONING_EFFORT=low
# 同時送往 Groq 的請求數，以及 429、5xx、逾時的總嘗試次數（400 json_validate_failed 另外重試一次）。
GROQ_MAX_CONCURRENCY=2
GROQ_TOTAL_ATTEMPTS=2

# compose 的 postgres 容器用這三個值建立帳號與資料庫。密碼請用長的隨機值，例如
# `openssl rand -hex 32`；只用英數字，放進 DATABASE_URL 時不必跳脫。
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=<長的隨機值>
POSTGRES_DB=helpdesk
# 帳號、密碼、資料庫名稱必須和上面三個值相同。主機名稱 postgres 是本專案網路上的容器。
DATABASE_URL=postgresql+asyncpg://helpdesk:<POSTGRES_PASSWORD 的值>@postgres:5432/helpdesk

# 主機名稱 qdrant 是本專案網路上的容器。compose 用 QDRANT_API_KEY 設定 qdrant 容器的金鑰，
# 兩個程序也用它連線，所以必填。請用長的隨機值，例如 `openssl rand -hex 32`。
# 連線走 http，qdrant-client 啟動時會警告金鑰走未加密連線；qdrant 不對主機開 port，
# 流量只在本專案的 Docker 網路裡，所以可以接受。
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=<長的隨機值>
QDRANT_COLLECTION=helpdesk_chunks_v1

EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MAX_SEQUENCE_LENGTH=512
EMBEDDING_BATCH_SIZE=32

# CHUNK_MAX_TOKENS 必須小於 EMBEDDING_MAX_SEQUENCE_LENGTH，重疊必須小於目標長度。
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=50

RETRIEVAL_LIMIT=8
CANDIDATE_MULTIPLIER=3
# 關鍵字檢索的命中分數門檻：命中詞的權重（詞長，英數詞再加 1）加總至少要這麼多。
KEYWORD_MIN_SCORE=3
MAX_CHUNKS_PER_DOCUMENT=6
MAX_CONTEXT_TOKENS=6000
# 必須至少是 MAX_CONTEXT_TOKENS * 6 + REWRITE_HISTORY_TURNS * 2 * (REWRITE_TURN_MAX_CHARS * 6 + 64) + 8192，
# 否則啟動失敗。預設值算出來是 62576。
MAX_PROMPT_TOKENS=64000

# 追問改寫：最多帶幾輪歷史、每輪最多幾個字、改寫結果最多幾個字、最多等幾秒。失敗一律用原問題檢索。
REWRITE_HISTORY_TURNS=3
REWRITE_TURN_MAX_CHARS=500
REWRITE_MAX_CHARS=500
REWRITE_TIMEOUT_SECONDS=10
REWRITE_REASONING_EFFORT=low

# 提問在 helpdesk-api 裡背景處理：最多同時處理幾個回合。
TURN_MAX_CONCURRENCY=4
# 處理中的回合超過這麼多秒沒有進展，就視為中斷並標成 failed_unknown（啟動時與每分鐘檢查）。
# 必須至少是 (REWRITE_TIMEOUT_SECONDS + GROQ_TOTAL_TIMEOUT_SECONDS) * 2。
TURN_STALE_AFTER_SECONDS=300

# 容器裡的文件根目錄。compose 會把根目錄的 ./documents 唯讀掛載到這裡，並固定這個值。
DOCUMENTS_ROOT=/data/documents
MAX_FILE_SIZE_BYTES=104857600
# 檔案要連續這麼多次掃描都不見才刪除，最少 2。
MISSING_SCANS_BEFORE_DELETE=2
# 單次掃描不見的文件超過這個比例，或文件根目錄變成空的，就拒絕整次掃描，避免掛載失敗時誤刪。
MAX_MISSING_RATIO=0.25

# ingestion-worker 的 job 迴圈：最多重試幾次、lease 多久、第一次重試等多久（之後倍增）、閒置時多久查一次。
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=3600
WORKER_RETRY_BASE_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=2

# 每日掃描時間。ACL 開啟時，文件的生效日與到期日也以這個時區的今天判斷。
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Taipei
